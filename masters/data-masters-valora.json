    },
    "ar": {
      "role": "متخصصة فخ الدب",
      "description": "خطط للتقارب والمهارات الأربع ثم اجمع كل المتطلبات في ملخص واحد صغير."
    },
    "fr": {
      "role": "Maître de la chasse à l’ours",
      "description": "Planifiez l’affinité et les quatre compétences, puis regroupez tous les besoins dans un seul résumé compact."
    },
    "es": {
      "role": "Maestra de Caza del Oso",
      "description": "Planifica la afinidad y las cuatro habilidades y reúne todos los requisitos en un resumen compacto."
    },
    "de": {
      "role": "Bärenjagd-Meisterin",
      "description": "Plane Affinität und alle vier Fähigkeiten und sammle alle Anforderungen in einer kompakten Übersicht."
    },
    "tr": {
      "role": "Ayı Avı Uzmanı",
      "description": "Yakınlık ve dört beceriyi planlayın, tüm gereksinimleri tek kompakt özette toplayın."
    },
    "ko": {
      "role": "곰 사냥 마스터",
      "description": "친밀도와 네 가지 스킬을 계획하고 모든 요구량을 하나의 간결한 요약에 모으세요."
    },
    "ja": {
      "role": "熊狩りマスター",
      "description": "親密度と4つのスキルを計画し、必要量を1つのコンパクトな概要にまとめます。"
    },
    "zh": {
      "role": "猎熊专家",
      "description": "规划亲密度和四项技能，并在一个紧凑摘要中汇总全部需求。"
    }
